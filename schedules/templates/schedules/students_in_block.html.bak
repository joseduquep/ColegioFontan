{% extends 'base.html' %}
{% block breadcrumb %}
<a href="{% url 'home.home' %}">Inicio</a>
<span>/</span>
<a href="{% url 'tutors.tutors_list' %}">Tutores</a>
<span>/</span>
<a href="{% url 'tutor_schedule' tutor_id=tutor_id %}">Horario Tutor</a>
<span>/</span>
<span>
  Bloque {{ block_number }} –
  {% if block_day == "Monday" %}Lunes
  {% elif block_day == "Tuesday" %}Martes
  {% elif block_day == "Wednesday" %}Miércoles
  {% elif block_day == "Thursday" %}Jueves
  {% elif block_day == "Friday" %}Viernes
  {% endif %}
</span>
{% endblock %}

{% block content %}
<!-- DEBUG: PYTHON WRITE VERSION 4.0 -->
<div class="container mt-4">
  <h2>Estudiantes del Bloque {{ block_number }} –
    {% if block_day == "Monday" %}Lunes
    {% elif block_day == "Tuesday" %}Martes
    {% elif block_day == "Wednesday" %}Miércoles
    {% elif block_day == "Thursday" %}Jueves
    {% elif block_day == "Friday" %}Viernes
    {% elif block_day == "Saturday" %}Sábado
    {% elif block_day == "Sunday" %}Domingo
    {% else %}{{ block_day }}
    {% endif %}
  </h2>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>{{ workshop.name }} – {{ tutor.user.first_name }} {{ tutor.user.last_name }}</h3>
    <a href="{% url 'block_attendance_history' block_id_fixed %}" class="btn btn-info">
      <i class="bi bi-clock-history"></i> Ver Historial
    </a>
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addStudentModal">
      <i class="bi bi-plus-lg"></i> Agregar Estudiante
    </button>
  </div>

  {% if students_with_attendance %}
  <form method="POST">
    {% csrf_token %}
    <div class="d-flex justify-content-end mb-3">
      <button type="submit" class="btn btn-primary">Actualizar asistencia</button>
    </div>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Nombre</th>
          <th>Estado actual</th>
          <th>Nuevo estado</th>
        </tr>
      </thead>
      <tbody>
        {% for item in students_with_attendance %}
        <tr class="{% if item.current_status == 'absent' %}table-danger{% endif %}">
          <td>{{ item.student.name }} {{ item.student.lastname }}</td>
          <td>
            <span class="badge 
              {% if item.current_status == 'present' %}bg-success
               {% elif item.current_status == 'absent' %}bg-danger
               {% else %}bg-secondary{% endif %}">
              {% if item.current_status == 'present' %}Presente
              {% elif item.current_status == 'absent' %}Ausente
              {% else %}No llamado{% endif %}
            </span>
            {% if item.attendance and item.attendance.marked_by %}
            <small class="text-muted d-block">
              Por: {{ item.attendance.marked_by.get_full_name|default:item.attendance.marked_by.username }}
            </small>
            {% endif %}
          </td>
          <td>
            <select name="status_{{ item.student.student_id }}" class="form-select">
              <option value="neutral" {% if item.current_status=='neutral' %}selected{% endif %}>No llamado</option>
              <option value="present" {% if item.current_status=='present' %}selected{% endif %}>Presente</option>
              <option value="absent" {% if item.current_status=='absent' %}selected{% endif %}>Ausente</option>
            </select>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <button type="submit" class="btn btn-primary mt-3">Actualizar asistencia</button>
  </form>
  {% else %}
  <p class="alert alert-info">No hay estudiantes asignados a este bloque.</p>
  {% endif %}
</div>

<!-- Modal: Agregar Estudiante -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addStudentModalLabel">Agregar Estudiante al Bloque</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="studentSearch" class="form-label">Buscar Estudiante (Nombre o ID)</label>
          <input type="text" id="studentSearch" class="form-control" placeholder="Escriba para buscar...">
          <div id="searchResults" class="list-group mt-2"></div>
        </div>

        <!-- Alerta de Conflicto -->
        <div id="conflictAlert" class="alert alert-warning d-none">
          <p id="conflictMessage"></p>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary btn-sm" onclick="hideConflict()">Cancelar</button>
            <a id="goToStudentSchedule" href="#" target="_blank" class="btn btn-primary btn-sm">Ir al horario de <span
                id="conflictStudentName"></span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('studentSearch');
    const resultsDiv = document.getElementById('searchResults');
    const conflictAlert = document.getElementById('conflictAlert');
    const conflictMessage = document.getElementById('conflictMessage');
    const conflictStudentName = document.getElementById('conflictStudentName');
    const goToStudentSchedule = document.getElementById('goToStudentSchedule');

    let debounceTimer;

    searchInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      const query = this.value;
      if (query.length < 2) {
        resultsDiv.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(() => {
        fetch(`{% url 'ajax_search_students' %}?q=${query}&block_type={{ block.type }}`)
          .then(response => response.json())
          .then(data => {
            resultsDiv.innerHTML = '';
            data.results.forEach(student => {
              const btn = document.createElement('button');
              btn.className = 'list-group-item list-group-item-action';
              btn.textContent = student.text;
              btn.onclick = () => addStudent(student.id);
              resultsDiv.appendChild(btn);
            });
          });
      }, 300);
    });

    function addStudent(studentId) {
      hideConflict();
      const formData = new FormData();
      formData.append('student_id', studentId);
      formData.append('block_id', '{{ block.block_id }}');
      formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');

      fetch(`{% url 'add_student_to_block' %}`, {
        method: 'POST',
        body: formData
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else if (data.conflict) {
            conflictMessage.textContent = `El estudiante ${data.student_name} ya tiene ocupado este bloque con ${data.workshop_name}.`;
            conflictStudentName.textContent = data.student_name;
            goToStudentSchedule.href = data.student_schedule_url;
            conflictAlert.classList.remove('d-none');
          } else {
            alert(data.error || 'Ocurrió un error al agregar al estudiante.');
          }
        });
    }

    window.hideConflict = function () {
      conflictAlert.classList.add('d-none');
    };
  });
</script>
{% endblock %}